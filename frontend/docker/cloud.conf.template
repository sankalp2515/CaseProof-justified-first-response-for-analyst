# CaseProof frontend, cloud profile. The HTTPS load balancer routes /v1/* and
# /health to the API service; this service only serves static assets and turns
# customer capability links into the scoped React reply route. The React page
# validates the capability through /v1/customer/{token}; nothing is proxied here.
server {
    listen 8080;
    server_name _;
    access_log off;
    server_tokens off;
    # Relative Location headers: the public scheme/port differ from this listener.
    absolute_redirect off;
    client_max_body_size 1k;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header X-Frame-Options DENY always;
    add_header Strict-Transport-Security "max-age=31536000" always;

    location = / {
        root /usr/share/nginx/html;
        try_files /app/landing/index.html =404;
        add_header Cache-Control no-cache always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;
        add_header X-Frame-Options DENY always;
        add_header Strict-Transport-Security "max-age=31536000" always;
    }

    location = /app {
        return 301 /app/;
    }

    location ~ "^/customer/([A-Za-z0-9_-]{16,256})$" {
        add_header Cache-Control no-store always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;
        add_header X-Frame-Options DENY always;
        add_header Strict-Transport-Security "max-age=31536000" always;
        return 303 /app/#/victim/reply/$1;
    }

    location /app/ {
        root /usr/share/nginx/html;
        index index.html;
        try_files $uri $uri/ =404;
        location /app/assets/ {
            root /usr/share/nginx/html;
            add_header Cache-Control "public, max-age=31536000, immutable" always;
            add_header X-Content-Type-Options nosniff always;
            add_header Referrer-Policy no-referrer always;
            add_header X-Frame-Options DENY always;
            add_header Strict-Transport-Security "max-age=31536000" always;
        }
        location = /app/index.html {
            root /usr/share/nginx/html;
            add_header Cache-Control "no-cache" always;
            add_header X-Content-Type-Options nosniff always;
            add_header Referrer-Policy no-referrer always;
            add_header X-Frame-Options DENY always;
            add_header Strict-Transport-Security "max-age=31536000" always;
        }
    }

    location / {
        return 404;
    }
}
