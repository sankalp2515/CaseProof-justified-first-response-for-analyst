FROM mcr.microsoft.com/playwright:v1.64.0-noble@sha256:06a9939e57531807f8d5fd76ce44b53165ffb7d7501d87ab10e285c20b1e971f
WORKDIR /qa
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
RUN npm install --save-exact playwright@1.64.0
COPY scripts/check_docker_browser.cjs ./check.cjs
COPY scripts/check_bank_browser.cjs ./check-bank.cjs
COPY scripts/check_victim_browser.cjs ./check-victim.cjs
CMD ["node", "check.cjs"]
