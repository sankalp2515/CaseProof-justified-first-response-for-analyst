# Optional host development profile. Does not deploy the app or migrate local databases.
# Load into a separate process; do not overwrite the existing .env or local Compose settings.
LLM_PROVIDER=vertex
LLM_MODE=live
ALLOW_FALLBACK=false
GOOGLE_CLOUD_PROJECT=caseproof-511713
GOOGLE_CLOUD_LOCATION=asia-south1
GEMINI_MODEL=gemini-2.5-flash
STORAGE_BACKEND=gcs
GCS_BUCKET=caseproof-511713-evidence-mumbai
LLM_MAX_CALLS_PER_CASE=8
LLM_DAILY_CALL_CAP=20
# Cases/jobs/bank data still require durable cloud adapters before Cloud Run deployment.
# ADC is obtained on the host; never copy its JSON into the repository or image.
